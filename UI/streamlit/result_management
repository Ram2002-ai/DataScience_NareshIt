                # Get student_id from roll number
                cursor.execute("SELECT student_id FROM students WHERE roll_number=?", (values[1],))
                student_id = cursor.fetchone()[0]
                
                # Get subject_id from subject name
                cursor.execute("SELECT subject_id FROM subjects WHERE subject_name=?", (values[3],))
                subject_id = cursor.fetchone()[0]
                
                # Set comboboxes
                for item in self.student_combo['values']:
                    if item.startswith(str(student_id)):
                        self.student_combo.set(item)
                        break
                        
                for item in self.subject_combo['values']:
                    if item.startswith(str(subject_id)):
                        self.subject_combo.set(item)
                        break
                
                self.exam_type_combo.set(values[4])
                self.exam_year_combo.set(values[5])
                self.obtained_marks_entry.delete(0, tk.END)
                self.obtained_marks_entry.insert(0, values[6])
                
            except pyodbc.Error as e:
                print(f"Error setting result form: {e}")
                
    def __del__(self):
        if self.db_connection:
            self.db_connection.close()
            print("Database connection closed")

def main():
    root = tk.Tk()
    app = ResultDeclarationApp(root)
    root.mainloop()

if __name__ == "__main__":
    main()