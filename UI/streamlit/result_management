                           SUM(CASE WHEN r.result_status = 'Pass' THEN 1 ELSE 0 END) as passed_subjects,
                           COUNT(r.result_id) as total_subjects
                    FROM students s
                    LEFT JOIN results r ON s.student_id = r.student_id
                    LEFT JOIN subjects sub ON r.subject_id = sub.subject_id
                    WHERE s.class = ? AND r.exam_type = ? AND r.exam_year = ?
                    GROUP BY s.student_id, s.name, s.roll_number
