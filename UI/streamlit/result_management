    def search_results(self):
        search_by = self.search_by.get()
        search_term = self.search_entry.get()
        
        if not search_term:
            messagebox.showerror("Error", "Please enter search term!")
            return
            
        try:
            cursor = self.db_connection.cursor()
            
            if search_by == 'Roll Number':
                query = """
                    SELECT s.roll_number, s.name, s.class, s.section, 
                           sub.subject_name, r.exam_type, r.exam_year, 
                           r.obtained_marks, sub.max_marks, r.grade, r.result_status
                    FROM results r
                    JOIN students s ON r.student_id = s.student_id
                    JOIN subjects sub ON r.subject_id = sub.subject_id
                    WHERE s.roll_number LIKE ?
                    ORDER BY r.declaration_date DESC
                """
                cursor.execute(query, (f'%{search_term}%',))
                
            elif search_by == 'Student Name':
                query = """
                    SELECT s.roll_number, s.name, s.class, s.section, 
                           sub.subject_name, r.exam_type, r.exam_year, 
                           r.obtained_marks, sub.max_marks, r.grade, r.result_status
                    FROM results r
                    JOIN students s ON r.student_id = s.student_id
                    JOIN subjects sub ON r.subject_id = sub.subject_id
                    WHERE s.name LIKE ?
                    ORDER BY r.declaration_date DESC
                """
                cursor.execute(query, (f'%{search_term}%',))
                
            elif search_by == 'Class':
                query = """
                    SELECT s.roll_number, s.name, s.class, s.section, 
                           sub.subject_name, r.exam_type, r.exam_year, 
                           r.obtained_marks, sub.max_marks, r.grade, r.result_status
                    FROM results r
                    JOIN students s ON r.student_id = s.student_id
                    JOIN subjects sub ON r.subject_id = sub.subject_id
                    WHERE s.class LIKE ?
                    ORDER BY s.name, sub.subject_name
                """
                cursor.execute(query, (f'%{search_term}%',))
                
            elif search_by == 'Exam Type':
                query = """
                    SELECT s.roll_number, s.name, s.class, s.section, 
                           sub.subject_name, r.exam_type, r.exam_year, 
                           r.obtained_marks, sub.max_marks, r.grade, r.result_status
                    FROM results r
                    JOIN students s ON r.student_id = s.student_id
                    JOIN subjects sub ON r.subject_id = sub.subject_id
                    WHERE r.exam_type LIKE ?
                    ORDER BY r.declaration_date DESC
                """
                cursor.execute(query, (f'%{search_term}%',))
            
            results = cursor.fetchall()
            
            # Display results
            self.search_text.delete('1.0', tk.END)
            
            if not results:
                self.search_text.insert('1.0', "No results found!")
                return
                
            current_student = None
            for result in results:
                if current_student != result[0]:
                    current_student = result[0]
                    self.search_text.insert(tk.END, f"\n{'='*60}\n", 'heading')
                    self.search_text.insert(tk.END, f"Roll No: {result[0]}\n")
                    self.search_text.insert(tk.END, f"Name: {result[1]}\n")
                    self.search_text.insert(tk.END, f"Class: {result[2]} - Section: {result[3]}\n")
                    self.search_text.insert(tk.END, f"{'='*60}\n\n", 'heading')
                
                tag = 'pass' if result[10] == 'Pass' else 'fail'
                self.search_text.insert(tk.END, f"{result[4]}: {result[7]}/{result[8]} ")
                self.search_text.insert(tk.END, f"(Grade: {result[9]}) ", tag)
                self.search_text.insert(tk.END, f"[{result[10]}]\n")
                
        except pyodbc.Error as e:
            messagebox.showerror("Error", f"Search failed: {e}")
            
    def generate_report_card(self):
        # Get selected student
        selected = self.student_tree.selection()
        if not selected:
            messagebox.showerror("Error", "Please select a student from the Student Management tab!")
            return
            
        student_id = self.student_tree.item(selected[0])['values'][0]
        
        try:
            cursor = self.db_connection.cursor()
            
            # Get student details
            cursor.execute("SELECT * FROM students WHERE student_id=?", (student_id,))
            student = cursor.fetchone()
            
            # Get all results for this student
            cursor.execute("""
                SELECT sub.subject_name, r.exam_type, r.exam_year, r.obtained_marks, 
                       sub.max_marks, r.grade, r.result_status
                FROM results r
                JOIN subjects sub ON r.subject_id = sub.subject_id
                WHERE r.student_id=?
                ORDER BY r.exam_year DESC, r.exam_type
            """, (student_id,))
            results = cursor.fetchall()
            
            if not results:
                messagebox.showinfo("Info", "No results found for this student!")
                return
                
            # Create report window
            report_window = tk.Toplevel(self.root)
            report_window.title("Report Card")
            report_window.geometry("600x500")
            
            # Report text widget
            report_text = scrolledtext.ScrolledText(report_window, width=80, height=30)
            report_text.pack(fill='both', expand=True, padx=10, pady=10)
            
            # Configure tags
            report_text.tag_configure('heading', font=('Arial', 14, 'bold'))
            report_text.tag_configure('subheading', font=('Arial', 12, 'bold'))
            report_text.tag_configure('pass', foreground='green')
            report_text.tag_configure('fail', foreground='red')
            
            # Generate report
            report_text.insert(tk.END, "="*60 + "\n", 'heading')
            report_text.insert(tk.END, "          STUDENT REPORT CARD\n", 'heading')
            report_text.insert(tk.END, "="*60 + "\n\n", 'heading')
            
            report_text.insert(tk.END, f"Roll Number: {student[1]}\n")
            report_text.insert(tk.END, f"Student Name: {student[2]}\n")
            report_text.insert(tk.END, f"Class: {student[3]} - Section: {student[4]}\n")
            report_text.insert(tk.END, f"Father's Name: {student[5]}\n")
            report_text.insert(tk.END, f"Mother's Name: {student[6]}\n\n")
            
            report_text.insert(tk.END, "-"*60 + "\n", 'subheading')
            report_text.insert(tk.END, f"{'Subject':<20} {'Exam':<15} {'Marks':<15} {'Grade':<10}\n", 'subheading')
            report_text.insert(tk.END, "-"*60 + "\n", 'subheading')
            
            total_marks = 0
            total_max = 0
            for result in results:
                subject, exam_type, year, obtained, max_m, grade, status = result
                tag = 'pass' if status == 'Pass' else 'fail'
                
                report_text.insert(tk.END, f"{subject:<20} {exam_type} ({year})  ")
                report_text.insert(tk.END, f"{obtained:.1f}/{max_m:<10} ", tag)
                report_text.insert(tk.END, f"{grade:<10}\n")
                
                total_marks += obtained
                total_max += max_m
            
            report_text.insert(tk.END, "-"*60 + "\n", 'subheading')
            
            percentage = (total_marks / total_max) * 100 if total_max > 0 else 0
            overall_grade = self.calculate_grade(total_marks, total_max)
            
            report_text.insert(tk.END, f"\nTotal Marks: {total_marks:.1f}/{total_max}\n")
            report_text.insert(tk.END, f"Percentage: {percentage:.2f}%\n")
            report_text.insert(tk.END, f"Overall Grade: {overall_grade}\n")
            
            report_text.insert(tk.END, "\n" + "="*60 + "\n", 'heading')
            report_text.insert(tk.END, "           ** END OF REPORT **\n", 'heading')
            report_text.insert(tk.END, "="*60 + "\n", 'heading')
            
            # Make text read-only
            report_text.config(state='disabled')
            
        except pyodbc.Error as e:
            messagebox.showerror("Error", f"Failed to generate report: {e}")
            
