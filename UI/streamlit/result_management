    # Database Operations - Modified for SQL Server
    def load_students(self):
        # Clear existing items
        for item in self.student_tree.get_children():
            self.student_tree.delete(item)
        
        try:
            cursor = self.db_connection.cursor()
            cursor.execute("""
                SELECT student_id, roll_number, name, class, section, contact_number 
                FROM students
            """)
            students = cursor.fetchall()
            
            for student in students:
                self.student_tree.insert('', 'end', values=student)
                
        except pyodbc.Error as e:
            messagebox.showerror("Error", f"Failed to load students: {e}")
            
    def load_subjects(self):
        # Clear existing items
        for item in self.subject_tree.get_children():
            self.subject_tree.delete(item)
        
        try:
            cursor = self.db_connection.cursor()
            cursor.execute("SELECT * FROM subjects")
            subjects = cursor.fetchall()
            
            for subject in subjects:
                self.subject_tree.insert('', 'end', values=subject)
                
        except pyodbc.Error as e:
            messagebox.showerror("Error", f"Failed to load subjects: {e}")
            
    def load_results(self):
        # Clear existing items
        for item in self.result_tree.get_children():
            self.result_tree.delete(item)
        
        try:
            cursor = self.db_connection.cursor()
            cursor.execute("""
                SELECT r.result_id, s.roll_number, s.name, sub.subject_name, 
                       r.exam_type, r.exam_year, r.obtained_marks, r.grade, r.result_status
                FROM results r
                JOIN students s ON r.student_id = s.student_id
                JOIN subjects sub ON r.subject_id = sub.subject_id
                ORDER BY r.declaration_date DESC
            """)
            results = cursor.fetchall()
            
            for result in results:
                self.result_tree.insert('', 'end', values=result)
                
        except pyodbc.Error as e:
            messagebox.showerror("Error", f"Failed to load results: {e}")
            
    def load_student_combo(self):
        try:
            cursor = self.db_connection.cursor()
            cursor.execute("SELECT student_id, CONCAT(roll_number, ' - ', name) FROM students")
            students = cursor.fetchall()
            self.student_combo['values'] = [f"{s[0]}|{s[1]}" for s in students]
        except pyodbc.Error as e:
            messagebox.showerror("Error", f"Failed to load students: {e}")
            
    def load_subject_combo(self):
        try:
            cursor = self.db_connection.cursor()
            cursor.execute("SELECT subject_id, subject_name FROM subjects")
            subjects = cursor.fetchall()
            self.subject_combo['values'] = [f"{s[0]}|{s[1]}" for s in subjects]
        except pyodbc.Error as e:
            messagebox.showerror("Error", f"Failed to load subjects: {e}")
            
    def calculate_grade(self, marks, max_marks=100):
        percentage = (marks / max_marks) * 100
        
        if percentage >= 90:
            return 'A+'
        elif percentage >= 80:
            return 'A'
        elif percentage >= 70:
            return 'B+'
        elif percentage >= 60:
            return 'B'
        elif percentage >= 50:
            return 'C'
        elif percentage >= 40:
            return 'D'
        else:
            return 'F'
            
    def add_student(self):
        # Get form data
        data = {
            'roll_number': self.student_entries['roll_entry'].get(),
            'name': self.student_entries['name_entry'].get(),
            'class': self.student_entries['class_entry'].get(),
            'section': self.student_entries['section_entry'].get(),
            'father_name': self.student_entries['father_entry'].get(),
            'mother_name': self.student_entries['mother_entry'].get(),
            'date_of_birth': self.student_entries['dob_entry'].get(),
            'contact_number': self.student_entries['contact_entry'].get(),
            'email': self.student_entries['email_entry'].get()
        }
        
        # Validate
        if not data['roll_number'] or not data['name']:
            messagebox.showerror("Error", "Roll Number and Name are required!")
            return
            
        try:
            cursor = self.db_connection.cursor()
            query = """
                INSERT INTO students 
                (roll_number, name, class, section, father_name, mother_name, date_of_birth, contact_number, email)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
            """  # SQL Server uses ? as parameter placeholder
            cursor.execute(query, tuple(data.values()))
            self.db_connection.commit()
            
            messagebox.showinfo("Success", "Student added successfully!")
            self.clear_student_form()
            self.load_students()
            self.load_student_combo()
            
        except pyodbc.Error as e:
            messagebox.showerror("Error", f"Failed to add student: {e}")
            
    def update_student(self):
        selected = self.student_tree.selection()
        if not selected:
            messagebox.showerror("Error", "Please select a student to update!")
            return
            
        student_id = self.student_tree.item(selected[0])['values'][0]
        
        # Get form data
        data = {
            'roll_number': self.student_entries['roll_entry'].get(),
            'name': self.student_entries['name_entry'].get(),
            'class': self.student_entries['class_entry'].get(),
            'section': self.student_entries['section_entry'].get(),
            'father_name': self.student_entries['father_entry'].get(),
            'mother_name': self.student_entries['mother_entry'].get(),
            'date_of_birth': self.student_entries['dob_entry'].get(),
            'contact_number': self.student_entries['contact_entry'].get(),
            'email': self.student_entries['email_entry'].get(),
            'student_id': student_id
        }
        
        try:
            cursor = self.db_connection.cursor()
            query = """
                UPDATE students 
                SET roll_number=?, name=?, class=?, section=?, father_name=?, 
                    mother_name=?, date_of_birth=?, contact_number=?, email=?
                WHERE student_id=?
            """
            cursor.execute(query, tuple(data.values()))
            self.db_connection.commit()
            
            messagebox.showinfo("Success", "Student updated successfully!")
            self.load_students()
            self.load_student_combo()
            
        except pyodbc.Error as e:
            messagebox.showerror("Error", f"Failed to update student: {e}")
            
    def delete_student(self):
        selected = self.student_tree.selection()
        if not selected:
            messagebox.showerror("Error", "Please select a student to delete!")
            return
            
        if messagebox.askyesno("Confirm", "Are you sure you want to delete this student?"):
            student_id = self.student_tree.item(selected[0])['values'][0]
            
            try:
                cursor = self.db_connection.cursor()
                cursor.execute("DELETE FROM students WHERE student_id=?", (student_id,))
                self.db_connection.commit()
                
                messagebox.showinfo("Success", "Student deleted successfully!")
                self.clear_student_form()
                self.load_students()
                self.load_student_combo()
                
            except pyodbc.Error as e:
                messagebox.showerror("Error", f"Failed to delete student: {e}")
                
