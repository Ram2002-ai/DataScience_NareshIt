    def connect_to_database(self):
        """Connect to SQL Server database"""
        try:
            # Connection parameters - MODIFY THESE BASED ON YOUR SQL SERVER SETUP
            server = 'localhost'  # or 'localhost\SQLEXPRESS' for SQL Server Express
            database = 'result_declaration'
            
            # Windows Authentication
            connection_string = f'DRIVER={{ODBC Driver 17 for SQL Server}};SERVER={server};DATABASE={database};Trusted_Connection=yes;'
            
            # For SQL Server Authentication, use this instead:
            # username = 'your_username'
            # password = 'your_password'
            # connection_string = f'DRIVER={{ODBC Driver 17 for SQL Server}};SERVER={server};DATABASE={database};UID={username};PWD={password}'
            
            self.db_connection = pyodbc.connect(connection_string)
            
            if self.db_connection:
                print("Connected to SQL Server database")
                print(f"Server: {server}, Database: {database}")
                
        except pyodbc.Error as e:
            messagebox.showerror("Database Error", f"Error connecting to database: {e}\n\n"
                                 "Please check:\n"
                                 "1. SQL Server is running\n"
                                 "2. Database 'result_declaration' exists\n"
                                 "3. Connection parameters are correct")
            
